# Semester OS Environment Variables
# Copy to .env.local and fill in your values

# Demo mode: run with in-memory store, no Supabase needed
DEMO_MODE=true

# LLM (BYOK - bring your own key)
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# Supabase (leave empty for DEMO_MODE)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
